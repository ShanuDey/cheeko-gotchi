# Copy to .env (git-ignored). Never put tokens in this example file.
# Page to show on the device. The built-in clock needs no outside site. Many public
# sites block headless browsers (time.is shows "please do not scrape"); only point
# this at your own pages or sites whose terms allow it.
TARGET_URL=file:///app/pages/clock.html
# Pixels of black border to keep content out of the rounded corners.
MARGIN_PX=20
JPEG_QUALITY=80
# IANA timezone used by pages that show the time.
TIMEZONE=Asia/Kolkata
# Seconds between full page reloads; frames in between are screenshots of the live page.
REFRESH_SECONDS=30
