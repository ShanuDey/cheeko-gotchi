# Copy to .env (git-ignored). Never put tokens in this file.
# Many public sites block headless browsers; only use your own pages or sites that allow it.
TARGET_URL=file:///app/pages/clock.html
# Fallback page when the request names none; the device picks via Display Frame Source / Display Frame URL.
# Optional: comma separated hostnames the device may request (empty = any http/https host).
ALLOWED_HOSTS=
# Set to 1 to open DevTools on port 28241 (chrome://inspect). Gives the whole LAN control
# of the browser, so turn it off again when done.
DEVTOOLS=
# Black border around the page in px (0 to 20). 0 = full screen; the bezel hides the corners.
MARGIN_PX=0
JPEG_QUALITY=80
TIMEZONE=Asia/Kolkata
REFRESH_SECONDS=30
